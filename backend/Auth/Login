from fastapi import APIRouter, Depends
from pydantic import BaseModel, EmailStr
from sqlalchemy.orm import Session

from db.session import get_db  # matches your main.py usage

from main.py import (  # e.g., from auth_session import issue_email_password_session, ensure_dev_user, TokenPair
    issue_email_password_session,
    ensure_dev_user,
    TokenPair,
)

auth_router = APIRouter(prefix="/auth", tags=["auth"])


class LoginRequest(BaseModel):
    email: EmailStr
    password: str


@auth_router.post("/login", response_model=TokenPair)
def login(
    body: LoginRequest,
    db: Session = Depends(get_db),
):
    """
    Email + password login.
    Returns access + refresh token pair.
    """
    return issue_email_password_session(db, email=body.email, password=body.password)
